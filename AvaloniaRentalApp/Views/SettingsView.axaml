<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:AvaloniaRentalApp.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="AvaloniaRentalApp.Views.SettingsView"
             x:DataType="vm:SettingsViewModel"
             Background="{DynamicResource BgDark}">

    <UserControl.Styles>
        <!-- Field label -->
        <Style Selector="TextBlock.field-label">
            <Setter Property="Foreground" Value="{DynamicResource Text2}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <!-- Input -->
        <Style Selector="TextBox.field-input">
            <Setter Property="Background" Value="{DynamicResource BgDark}" />
            <Setter Property="Foreground" Value="{DynamicResource Text1}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,8" />
        </Style>
        <!-- Section title -->
        <Style Selector="TextBlock.section-title">
            <Setter Property="Foreground" Value="{DynamicResource Text1}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.section-sub">
            <Setter Property="Foreground" Value="{DynamicResource Text2}" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer Padding="30" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="20" MaxWidth="900" HorizontalAlignment="Stretch">

            <!-- Header -->
            <StackPanel>
                <TextBlock Text="Ustawienia" FontSize="28" FontWeight="Bold"
                           Foreground="{DynamicResource Text1}" />
                <TextBlock Text="Konfiguracja systemu i bazy danych"
                           Foreground="{DynamicResource Text2}" FontSize="14" Margin="0,5,0,0" />
            </StackPanel>

            <!-- Card: Database connection -->
            <Border Background="{DynamicResource BgCard}" CornerRadius="12" Padding="20">
                <StackPanel Spacing="16">
                    <StackPanel>
                        <TextBlock Classes="section-title" Text="🗄️ Połączenie z bazą danych" />
                        <TextBlock Classes="section-sub" Text="Konfiguracja MariaDB" Margin="0,2,0,0" />
                    </StackPanel>
                    <Border Height="1" Background="{DynamicResource Border}" />

                    <Grid ColumnDefinitions="*,16,*" RowDefinitions="Auto,16,Auto,16,Auto">
                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <TextBlock Classes="field-label" Text="Host" />
                            <TextBox Classes="field-input" Text="{Binding DbHost}" />
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="2">
                            <TextBlock Classes="field-label" Text="Port" />
                            <TextBox Classes="field-input" Text="{Binding DbPort}" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0">
                            <TextBlock Classes="field-label" Text="Baza danych" />
                            <TextBox Classes="field-input" Text="{Binding DbDatabase}" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="2">
                            <TextBlock Classes="field-label" Text="Użytkownik" />
                            <TextBox Classes="field-input" Text="{Binding DbUser}" />
                        </StackPanel>

                        <StackPanel Grid.Row="4" Grid.Column="0">
                            <TextBlock Classes="field-label" Text="Hasło" />
                            <TextBox Classes="field-input" Text="{Binding DbPassword}" PasswordChar="●" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="💾 Zapisz konfigurację" Command="{Binding SaveConnectionCommand}"
                                Background="{DynamicResource Accent}" Foreground="White"
                                FontWeight="Bold" BorderBrush="Transparent" CornerRadius="6" Padding="16,10" />
                        <Button Content="🔌 Testuj połączenie" Command="{Binding TestConnectionCommand}"
                                Background="{DynamicResource BgMid}" Foreground="{DynamicResource Text1}"
                                BorderBrush="Transparent" CornerRadius="6" Padding="16,10" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Card: Fuel prices -->
            <Border Background="{DynamicResource BgCard}" CornerRadius="12"
                    ClipToBounds="True">
                <StackPanel Spacing="12">
                    <StackPanel Margin="16,16,16,0">
                        <TextBlock Classes="section-title" Text="⛽ Ceny paliw" />
                        <TextBlock Classes="section-sub"
                                   Text="Ceny paliw używane do obliczania kosztu paliwa i przychodu netto"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding FuelPrices}"
                              AutoGenerateColumns="False" IsReadOnly="False"
                              HeadersVisibility="Column"
                              CanUserReorderColumns="False" CanUserResizeColumns="False"
                              CanUserSortColumns="False"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{DynamicResource Border}"
                              VerticalGridLinesBrush="Transparent"
                              Background="Transparent"
                              RowBackground="{DynamicResource BgCard}"
                              Foreground="{DynamicResource Text1}"
                              BorderThickness="0">
                        <DataGrid.Styles>
                            <Style Selector="DataGridColumnHeader">
                                <Setter Property="Background" Value="{DynamicResource BgMid}" />
                                <Setter Property="Foreground" Value="{DynamicResource Text2}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="FontSize" Value="10" />
                                <Setter Property="Padding" Value="16,10" />
                                <Setter Property="BorderThickness" Value="0,0,0,1" />
                                <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
                                <Setter Property="AreSeparatorsVisible" Value="False" />
                            </Style>
                            <Style Selector="DataGridCell">
                                <Setter Property="Padding" Value="16,10" />
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                                <Setter Property="Foreground" Value="{DynamicResource Text1}" />
                                <Setter Property="FontSize" Value="13" />
                            </Style>
                            <Style Selector="DataGridRow">
                                <Setter Property="MinHeight" Value="44" />
                            </Style>
                        </DataGrid.Styles>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="RODZAJ PALIWA" Binding="{Binding DisplayType}"
                                                IsReadOnly="True" Width="2*" />
                            <DataGridTextColumn Header="CENA ZA JEDNOSTKĘ"
                                                Binding="{Binding PricePerUnit, StringFormat={}{0:N2}}" Width="1.5*" />
                            <DataGridTextColumn Header="JEDNOSTKA" Binding="{Binding Unit}" Width="1*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                Spacing="10" Margin="16,0,16,16">
                        <Button Content=" Odśwież " Command="{Binding LoadCommand}"
                                Background="{DynamicResource BgMid}" Foreground="{DynamicResource Text1}"
                                BorderBrush="Transparent" CornerRadius="6" Padding="20,10" />
                        <Button Content="Zapisz" Command="{Binding SaveCommand}"
                                Background="{DynamicResource Accent}" Foreground="White"
                                FontWeight="Bold" CornerRadius="6" Padding="20,10" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Card: Application info -->
            <Border Background="{DynamicResource BgCard}" CornerRadius="12" Padding="20">
                <StackPanel Spacing="16">
                    <TextBlock Classes="section-title" Text="ℹ️ Informacje o aplikacji" />
                    <Border Height="1" Background="{DynamicResource Border}" />
                    <Grid ColumnDefinitions="200,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                          RowSpacing="10">
                        <TextBlock Grid.Row="0" Grid.Column="0" Classes="field-label" Text="Wersja" Margin="0" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Foreground="{DynamicResource Text1}" Text="{Binding AppVersion}" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Classes="field-label" Text="Framework" Margin="0" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Foreground="{DynamicResource Text1}" Text="{Binding Framework}" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Classes="field-label" Text="Baza danych" Margin="0" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Foreground="{DynamicResource Text1}" Text="{Binding DatabaseInfo}" />
                        <TextBlock Grid.Row="3" Grid.Column="0" Classes="field-label" Text="ORM / Data" Margin="0" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Foreground="{DynamicResource Text1}" Text="{Binding OrmInfo}" />
                        <TextBlock Grid.Row="4" Grid.Column="0" Classes="field-label" Text="MVVM" Margin="0" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Foreground="{DynamicResource Text1}" Text="{Binding MvvmInfo}" />
                        <TextBlock Grid.Row="5" Grid.Column="0" Classes="field-label" Text="Licencja" Margin="0" />
                        <TextBlock Grid.Row="5" Grid.Column="1" Foreground="{DynamicResource Text1}" Text="{Binding License}" />
                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
