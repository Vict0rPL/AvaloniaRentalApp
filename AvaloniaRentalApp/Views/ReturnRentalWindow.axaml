<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:AvaloniaRentalApp.ViewModels"
        xmlns:conv="using:AvaloniaRentalApp.Converters"
        mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="650"
        x:Class="AvaloniaRentalApp.Views.ReturnRentalWindow"
        x:DataType="vm:ReturnRentalViewModel"
        Title="Zwrot Pojazdu"
        Width="500" Height="680"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgDark}">

    <Grid RowDefinitions="Auto, *, Auto" Margin="25">
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Zwrot pojazdu" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource Text1}" />
            <TextBlock Text="{Binding Rental.RentalNumber, StringFormat='Umowa nr: {0}'}" Foreground="{DynamicResource Text2}" />
            <TextBlock Text="{Binding Rental.CarDisplay}" Foreground="{DynamicResource Accent}" FontWeight="SemiBold" />
        </StackPanel>

        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="20">
                <StackPanel Spacing="8">
                    <TextBlock Text="Data faktycznego zwrotu" Foreground="{DynamicResource Text2}" FontSize="12" />
                    <DatePicker SelectedDate="{Binding ReturnDate}" Background="{DynamicResource BgCard}" Foreground="{DynamicResource Text1}" />
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock Text="Aktualny przebieg (km)" Foreground="{DynamicResource Text2}" FontSize="12" />
                    <NumericUpDown Value="{Binding ReturnMileage}" Minimum="{Binding Rental.MileageStart}"
                                   Background="{DynamicResource BgCard}" Foreground="{DynamicResource Text1}"
                                   FormatString="0" />
                    <TextBlock Text="{Binding Rental.MileageStart, StringFormat='Przebieg przy wydaniu: {0} km'}" 
                               FontSize="11" Foreground="{DynamicResource Text3}" />
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock Text="Koszty uszkodzeń / kar (zł)" Foreground="{DynamicResource Text2}" FontSize="12" />
                    <NumericUpDown Value="{Binding DamageCost}" Minimum="0"
                                   Background="{DynamicResource BgCard}" Foreground="{DynamicResource Text1}"
                                   FormatString="N2" />
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock Text="Uwagi do zwrotu" Foreground="{DynamicResource Text2}" FontSize="12" />
                    <TextBox Text="{Binding Notes}" Height="80" TextWrapping="Wrap" AcceptsReturn="True"
                             Background="{DynamicResource BgCard}" BorderBrush="Transparent" Foreground="{DynamicResource Text1}" />
                </StackPanel>

                <Border Background="{DynamicResource BgCard}" CornerRadius="8" Padding="15" Margin="0,10,0,0">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Podsumowanie rozliczenia" FontWeight="Bold" Foreground="{DynamicResource Text1}" Margin="0,0,0,5" />
                        
                        <Grid ColumnDefinitions="*, Auto">
                            <TextBlock Grid.Column="0" Text="Koszt podstawowy:" Foreground="{DynamicResource Text2}" />
                            <TextBlock Grid.Column="1" Text="{Binding Rental.BaseCost, StringFormat='{}{0:N2} zł'}" Foreground="{DynamicResource Text1}" />
                        </Grid>

                        <Grid ColumnDefinitions="*, Auto" IsVisible="{Binding LateReturnCost, Converter={x:Static conv:NumberConverters.NotZero}}">
                            <TextBlock Grid.Column="0" Text="Kara za opóźnienie:" Foreground="{DynamicResource Red}" />
                            <TextBlock Grid.Column="1" Text="{Binding LateReturnCost, StringFormat='{}{0:N2} zł'}" Foreground="{DynamicResource Red}" FontWeight="Bold" />
                        </Grid>

                        <Grid ColumnDefinitions="*, Auto" IsVisible="{Binding DamageCost, Converter={x:Static conv:NumberConverters.NotZero}}">
                            <TextBlock Grid.Column="0" Text="Dodatkowe opłaty:" Foreground="{DynamicResource Amber}" />
                            <TextBlock Grid.Column="1" Text="{Binding DamageCost, StringFormat='{}{0:N2} zł'}" Foreground="{DynamicResource Amber}" />
                        </Grid>

                        <Separator Background="{DynamicResource Border}" Margin="0,5" />

                        <Grid ColumnDefinitions="*, Auto">
                            <TextBlock Grid.Column="0" Text="SUMA DO ZAPŁATY:" FontWeight="Bold" Foreground="{DynamicResource Text1}" FontSize="16" />
                            <TextBlock Grid.Column="1" Text="{Binding TotalCost, StringFormat='{}{0:N2} zł'}" FontWeight="Bold" Foreground="{DynamicResource Accent}" FontSize="18" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,20,0,0">
            <Button Content="Anuluj" Command="{Binding CancelCommand}"
                    Background="{DynamicResource BgHover}" Foreground="{DynamicResource Text1}" Padding="20,10" CornerRadius="6" />
            <Button Content="Zatwierdź zwrot" Command="{Binding ConfirmCommand}"
                    Background="{DynamicResource Accent}" Foreground="{DynamicResource Text1}" FontWeight="Bold" Padding="25,10" CornerRadius="6" />
        </StackPanel>
    </Grid>
</Window>
