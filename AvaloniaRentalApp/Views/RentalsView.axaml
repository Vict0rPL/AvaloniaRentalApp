<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:AvaloniaRentalApp.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
             x:Class="AvaloniaRentalApp.Views.RentalsView"
             x:DataType="vm:RentalsViewModel"
             Background="{DynamicResource BgDark}">

    <UserControl.Styles>
        <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource BgInput}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
        </Style>
        <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource BgHover}" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="ComboBox:focus /template/ Border">
            <Setter Property="Background" Value="{DynamicResource BgInput}" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="30,30,30,20">
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="Wypożyczenia" FontSize="28" FontWeight="Bold"
                           Foreground="{DynamicResource Text1}" />
                <TextBlock Text="Ewidencja umów wypożyczenia pojazdów"
                           Foreground="{DynamicResource Text2}" FontSize="14" Margin="0,5,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Button Content="Zmień płatność" Command="{Binding ChangePaymentStatusCommand}"
                        Background="{DynamicResource BgHover}" Foreground="{DynamicResource Text1}"
                        Padding="15,8" CornerRadius="6" />
                <Button Content="Anuluj wypożyczenie" Command="{Binding CancelRentalCommand}"
                        Background="{DynamicResource BgHover}" Foreground="{DynamicResource Text1}"
                        Padding="15,8" CornerRadius="6" />
                <Button Content="Zwróć pojazd" Command="{Binding ReturnRentalCommand}"
                        Background="{DynamicResource BgHover}" Foreground="{DynamicResource Text1}"
                        Padding="15,8" CornerRadius="6" />
                <Button Content="+ Nowe wypożyczenie" Command="{Binding AddRentalCommand}"
                        Background="{DynamicResource Accent}" Foreground="{DynamicResource Text1}"
                        FontWeight="Bold" CornerRadius="6" Padding="15,8" />
            </StackPanel>
        </Grid>

        <!-- Search bar -->
        <Border Grid.Row="1" Background="{DynamicResource BgCard}" CornerRadius="12"
                Margin="30,0,30,20" Padding="15">
            <Grid ColumnDefinitions="*, Auto, Auto">
                <TextBox Grid.Column="0"
                         Watermark="Szukaj po nr umowy, kliencie, pojeździe..."
                         Text="{Binding SearchText}"
                         Background="{DynamicResource BgInput}" BorderBrush="Transparent"
                         Foreground="{DynamicResource Text1}"
                         CornerRadius="6" Padding="12" Margin="0,0,15,0" VerticalAlignment="Center" />

                <ComboBox Grid.Column="1"
                          SelectedIndex="{Binding SelectedStatusIndex}"
                          Background="{DynamicResource BgInput}" Foreground="{DynamicResource Text1}"
                          BorderBrush="Transparent" CornerRadius="6" Width="160"
                          Margin="0,0,15,0" VerticalAlignment="Center" Padding="12">
                    <ComboBoxItem>Wszystkie</ComboBoxItem>
                    <ComboBoxItem>Aktywna</ComboBoxItem>
                    <ComboBoxItem>Zakończona</ComboBoxItem>
                    <ComboBoxItem>Anulowana</ComboBoxItem>
                    <ComboBoxItem>Przeterminowana</ComboBoxItem>
                </ComboBox>

                <Button Grid.Column="2" Content=" Odśwież " Command="{Binding RefreshCommand}"
                        Background="{DynamicResource BgInput}" Foreground="{DynamicResource Text1}"
                        BorderBrush="Transparent" CornerRadius="6" Padding="20,12"
                        VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- DataGrid -->
        <Border Grid.Row="2" Background="{DynamicResource BgCard}" CornerRadius="12"
                Margin="30,0,30,30" Padding="1" ClipToBounds="True">
            <DataGrid ItemsSource="{Binding Rentals}"
                      SelectedItem="{Binding SelectedRental}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="{DynamicResource Border}"
                      VerticalGridLinesBrush="Transparent"
                      Background="Transparent"
                      RowBackground="{DynamicResource BgCard}"
                      Foreground="{DynamicResource Text1}"
                      BorderThickness="0"
                      HeadersVisibility="Column"
                      CanUserReorderColumns="False"
                      CanUserResizeColumns="False"
                      CanUserSortColumns="True">

                <DataGrid.Styles>
                    <Style Selector="DataGridColumnHeader">
                        <Setter Property="Background" Value="{DynamicResource BgMid}"/>
                        <Setter Property="Foreground" Value="{DynamicResource Text2}"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="FontSize" Value="10"/>
                        <Setter Property="Padding" Value="16,10"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
                        <Setter Property="AreSeparatorsVisible" Value="False"/>
                    </Style>
                    <Style Selector="DataGridCell">
                        <Setter Property="Padding" Value="16,10"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="Foreground" Value="{DynamicResource Text2}"/>
                        <Setter Property="FontSize" Value="12"/>
                    </Style>
                    <Style Selector="DataGridCell TextBlock">
                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                    </Style>
                    <Style Selector="DataGridRow:selected">
                        <Setter Property="Background" Value="#12FFFFFF"/>
                    </Style>
                    <Style Selector="DataGridRow:selected:pointerover">
                        <Setter Property="Background" Value="#12FFFFFF"/>
                    </Style>
                    <Style Selector="DataGridRow:selected DataGridCell">
                        <Setter Property="Foreground" Value="{DynamicResource Text1}"/>
                    </Style>
                    <Style Selector="DataGridRow:pointerover">
                        <Setter Property="Background" Value="#12FFFFFF"/>
                    </Style>
                    <Style Selector="DataGridRow">
                        <Setter Property="MinHeight" Value="50" />
                    </Style>
                    <Style Selector="DataGridCell:current /template/ Grid#FocusVisual">
                        <Setter Property="IsVisible" Value="False" />
                    </Style>
                    <Style Selector="DataGridCell:focus /template/ Grid#FocusVisual">
                        <Setter Property="IsVisible" Value="False" />
                    </Style>
                </DataGrid.Styles>

                <DataGrid.Columns>

                    <!-- NR UMOWY -->
                    <DataGridTemplateColumn Header="NR UMOWY" Width="1.8*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding RentalNumber}" FontWeight="Bold"
                                           Foreground="{DynamicResource Text1}" VerticalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="KLIENT" Binding="{Binding CustomerName}" Width="2*" />
                    <DataGridTextColumn Header="POJAZD" Binding="{Binding CarDisplay}" Width="2*" />
                    <DataGridTextColumn Header="OD"
                                        Binding="{Binding DateStart, StringFormat={}{0:dd.MM.yyyy}}"
                                        Width="1.1*" />
                    <DataGridTextColumn Header="DO"
                                        Binding="{Binding DateEndPlanned, StringFormat={}{0:dd.MM.yyyy}}"
                                        Width="1.1*" />
                    <DataGridTextColumn Header="KOSZT"
                                        Binding="{Binding TotalCost, StringFormat={}{0:N2} zł}"
                                        Width="1*" />

                    <!-- STATUS badge -->
                    <DataGridTemplateColumn Header="STATUS" Width="1.3*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="10" Padding="10,3"
                                        HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <Border.Styles>
                                        <Style Selector="Border[Tag=green]">
                                            <Setter Property="Background" Value="{DynamicResource GreenBadge}"/>
                                        </Style>
                                        <Style Selector="Border[Tag=blue]">
                                            <Setter Property="Background" Value="{DynamicResource AccentBadge}"/>
                                        </Style>
                                        <Style Selector="Border[Tag=orange]">
                                            <Setter Property="Background" Value="{DynamicResource AmberBadge}"/>
                                        </Style>
                                        <Style Selector="Border[Tag=red]">
                                            <Setter Property="Background" Value="{DynamicResource RedBadge}"/>
                                        </Style>
                                        <Style Selector="Border[Tag=gray]">
                                            <Setter Property="Background" Value="#1F64748B"/>
                                        </Style>
                                    </Border.Styles>
                                    <Border.Tag>
                                        <Binding Path="StatusBadge"/>
                                    </Border.Tag>
                                    <TextBlock Text="{Binding DisplayStatus}" FontSize="11" FontWeight="SemiBold">
                                        <TextBlock.Styles>
                                            <Style Selector="TextBlock[Tag=green]">
                                                <Setter Property="Foreground" Value="{DynamicResource Green}"/>
                                            </Style>
                                            <Style Selector="TextBlock[Tag=blue]">
                                                <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                                            </Style>
                                            <Style Selector="TextBlock[Tag=orange]">
                                                <Setter Property="Foreground" Value="{DynamicResource Amber}"/>
                                            </Style>
                                            <Style Selector="TextBlock[Tag=red]">
                                                <Setter Property="Foreground" Value="{DynamicResource Red}"/>
                                            </Style>
                                            <Style Selector="TextBlock[Tag=gray]">
                                                <Setter Property="Foreground" Value="{DynamicResource Text3}"/>
                                            </Style>
                                        </TextBlock.Styles>
                                        <TextBlock.Tag>
                                            <Binding Path="StatusBadge"/>
                                        </TextBlock.Tag>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- PŁATNOŚĆ badge -->
                    <DataGridTemplateColumn Header="PŁATNOŚĆ" Width="1.3*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="10" Padding="10,3"
                                        HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <Border.Styles>
                                        <Style Selector="Border[Tag=green]">
                                            <Setter Property="Background" Value="{DynamicResource GreenBadge}"/>
                                        </Style>
                                        <Style Selector="Border[Tag=blue]">
                                            <Setter Property="Background" Value="{DynamicResource AccentBadge}"/>
                                        </Style>
                                        <Style Selector="Border[Tag=orange]">
                                            <Setter Property="Background" Value="{DynamicResource AmberBadge}"/>
                                        </Style>
                                        <Style Selector="Border[Tag=red]">
                                            <Setter Property="Background" Value="{DynamicResource RedBadge}"/>
                                        </Style>
                                        <Style Selector="Border[Tag=gray]">
                                            <Setter Property="Background" Value="#1F64748B"/>
                                        </Style>
                                    </Border.Styles>
                                    <Border.Tag>
                                        <Binding Path="PaymentBadge"/>
                                    </Border.Tag>
                                    <TextBlock Text="{Binding DisplayPayment}" FontSize="11" FontWeight="SemiBold">
                                        <TextBlock.Styles>
                                            <Style Selector="TextBlock[Tag=green]">
                                                <Setter Property="Foreground" Value="{DynamicResource Green}"/>
                                            </Style>
                                            <Style Selector="TextBlock[Tag=blue]">
                                                <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                                            </Style>
                                            <Style Selector="TextBlock[Tag=orange]">
                                                <Setter Property="Foreground" Value="{DynamicResource Amber}"/>
                                            </Style>
                                            <Style Selector="TextBlock[Tag=red]">
                                                <Setter Property="Foreground" Value="{DynamicResource Red}"/>
                                            </Style>
                                            <Style Selector="TextBlock[Tag=gray]">
                                                <Setter Property="Foreground" Value="{DynamicResource Text3}"/>
                                            </Style>
                                        </TextBlock.Styles>
                                        <TextBlock.Tag>
                                            <Binding Path="PaymentBadge"/>
                                        </TextBlock.Tag>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
