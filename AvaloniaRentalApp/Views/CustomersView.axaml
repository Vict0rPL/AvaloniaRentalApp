<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:AvaloniaRentalApp.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
             x:Class="AvaloniaRentalApp.Views.CustomersView"
             x:DataType="vm:CustomersViewModel"
             Background="{DynamicResource BgDark}">

    <UserControl.Styles>
        <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource BgInput}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
        </Style>
        <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource BgHover}" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="30,30,30,20">
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="Klienci" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource Text1}" />
                <TextBlock Text="Zarządzanie bazą klientów" Foreground="{DynamicResource Text2}" FontSize="14" Margin="0,5,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Button Content="Szczegóły" Command="{Binding ShowDetailsCommand}"
                        IsEnabled="{Binding SelectedCustomer, Converter={x:Static ObjectConverters.IsNotNull}}"
                        Background="{DynamicResource BgHover}" Foreground="{DynamicResource Text1}"
                        Padding="15,8" CornerRadius="6" />
                <Button Content="Edytuj" Command="{Binding EditCustomerCommand}"
                        IsEnabled="{Binding SelectedCustomer, Converter={x:Static ObjectConverters.IsNotNull}}"
                        IsVisible="{Binding !ShowArchived}"
                        Background="{DynamicResource BgHover}" Foreground="{DynamicResource Text1}"
                        Padding="15,8" CornerRadius="6" />
                <Button Content="Usuń" Command="{Binding DeleteCustomerCommand}"
                        IsEnabled="{Binding SelectedCustomer, Converter={x:Static ObjectConverters.IsNotNull}}"
                        IsVisible="{Binding !ShowArchived}"
                        Background="{DynamicResource Red}" Foreground="{DynamicResource Text1}"
                        FontWeight="Bold" CornerRadius="6" Padding="15,8" />
                <Button Content="Przywróć" Command="{Binding RestoreCustomerCommand}"
                        IsEnabled="{Binding SelectedCustomer, Converter={x:Static ObjectConverters.IsNotNull}}"
                        IsVisible="{Binding ShowArchived}"
                        Background="{DynamicResource Green}" Foreground="{DynamicResource Text1}"
                        FontWeight="Bold" CornerRadius="6" Padding="15,8" />

                <ToggleButton Content="Archiwum" IsChecked="{Binding ShowArchived}"
                              Background="{DynamicResource BgHover}" Foreground="{DynamicResource Text1}"
                              Padding="15,8" CornerRadius="6" />

                <Button Content="+ Dodaj klienta" Command="{Binding AddCustomerCommand}"
                        Background="{DynamicResource Accent}" Foreground="{DynamicResource Text1}"
                        FontWeight="Bold" CornerRadius="6" Padding="15,8"
                        IsVisible="{Binding !ShowArchived}" />
            </StackPanel>
        </Grid>

        <!-- Search Bar -->
        <Border Grid.Row="1" Background="{DynamicResource BgCard}" CornerRadius="12"
                Margin="30,0,30,20" Padding="15">
            <Grid ColumnDefinitions="*, Auto">
                <TextBox Grid.Column="0"
                         Watermark="Szukaj po nazwisku, imieniu, telefonie, e-mailu lub PESEL…"
                         Text="{Binding SearchText}"
                         Background="{DynamicResource BgInput}" BorderBrush="Transparent"
                         Foreground="{DynamicResource Text1}"
                         CornerRadius="6" Padding="12" Margin="0,0,15,0" VerticalAlignment="Center" />

                <Button Grid.Column="1" Content=" Odśwież " Command="{Binding RefreshCommand}"
                        Background="{DynamicResource BgInput}" Foreground="{DynamicResource Text1}"
                        BorderBrush="Transparent" CornerRadius="6" Padding="20,12" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- DataGrid -->
        <Border Grid.Row="2" Background="{DynamicResource BgCard}" CornerRadius="12"
                Margin="30,0,30,30" Padding="1" ClipToBounds="True">
            <DataGrid ItemsSource="{Binding Customers}"
                      SelectedItem="{Binding SelectedCustomer}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="{DynamicResource Border}"
                      VerticalGridLinesBrush="Transparent"
                      Background="Transparent"
                      RowBackground="{DynamicResource BgCard}"
                      Foreground="{DynamicResource Text1}"
                      BorderThickness="0"
                      HeadersVisibility="Column"
                      CanUserReorderColumns="False"
                      CanUserResizeColumns="False"
                      CanUserSortColumns="True">
                <DataGrid.Styles>
                    <Style Selector="DataGridColumnHeader">
                        <Setter Property="Background" Value="{DynamicResource BgMid}"/>
                        <Setter Property="Foreground" Value="{DynamicResource Text2}"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="FontSize" Value="10"/>
                        <Setter Property="Padding" Value="16,10"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
                        <Setter Property="AreSeparatorsVisible" Value="False"/>
                    </Style>
                    <Style Selector="DataGridCell">
                        <Setter Property="Padding" Value="16,10"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="Foreground" Value="{DynamicResource Text2}"/>
                        <Setter Property="FontSize" Value="12"/>
                    </Style>
                    <Style Selector="DataGridCell TextBlock">
                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                    </Style>
                    <Style Selector="DataGridRow:selected">
                        <Setter Property="Background" Value="#12FFFFFF"/>
                    </Style>
                    <Style Selector="DataGridRow:selected:pointerover">
                        <Setter Property="Background" Value="#12FFFFFF"/>
                    </Style>
                    <Style Selector="DataGridRow:selected DataGridCell">
                        <Setter Property="Foreground" Value="{DynamicResource Text1}"/>
                    </Style>
                    <Style Selector="DataGridRow:pointerover">
                        <Setter Property="Background" Value="#12FFFFFF"/>
                    </Style>
                    <Style Selector="DataGridRow">
                        <Setter Property="MinHeight" Value="50" />
                    </Style>
                    <Style Selector="DataGridCell:current /template/ Grid#FocusVisual">
                        <Setter Property="IsVisible" Value="False" />
                    </Style>
                    <Style Selector="DataGridCell:focus /template/ Grid#FocusVisual">
                        <Setter Property="IsVisible" Value="False" />
                    </Style>
                </DataGrid.Styles>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="IMIĘ I NAZWISKO" Width="2*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding FullName}" FontWeight="Bold"
                                           Foreground="{DynamicResource Text1}" VerticalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="PESEL" Binding="{Binding Pesel}" Width="1.3*" />
                    <DataGridTextColumn Header="TELEFON" Binding="{Binding Phone}" Width="1.2*" />
                    <DataGridTextColumn Header="E-MAIL" Binding="{Binding Email}" Width="2*" />
                    <DataGridTextColumn Header="MIASTO" Binding="{Binding AddressCity}" Width="1.2*" />
                    <DataGridTextColumn Header="NR PRAWA JAZDY" Binding="{Binding LicenseNumber}" Width="1.5*" />
                    <DataGridTextColumn Header="AKTYWNE WYP." Binding="{Binding ActiveRentals}" Width="1.2*" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

    </Grid>
</UserControl>
