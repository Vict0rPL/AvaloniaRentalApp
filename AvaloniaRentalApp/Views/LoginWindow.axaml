<rxui:ReactiveWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AvaloniaRentalApp.ViewModels"
        xmlns:rxui="http://reactiveui.net"
        x:Class="AvaloniaRentalApp.Views.LoginWindow"
        x:TypeArguments="vm:LoginViewModel"
        x:DataType="vm:LoginViewModel"
        Title="AutoWynajem — Logowanie"
        Width="880" Height="560"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        Background="#FF13151A">

    <Window.KeyBindings>
        <KeyBinding Gesture="Return" Command="{Binding LoginCommand}" />
    </Window.KeyBindings>

    <Grid ColumnDefinitions="320,*">

        <!-- Left brand panel -->
        <Border Grid.Column="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="20%,0%" EndPoint="80%,100%">
                    <GradientStop Color="#1e3a5f" Offset="0" />
                    <GradientStop Color="#0f1b2d" Offset="0.5" />
                    <GradientStop Color="#0a1628" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="0">
                <Border Width="72" Height="72" CornerRadius="18"
                        Background="{DynamicResource Accent}"
                        HorizontalAlignment="Center" Margin="0,0,0,20">
                    <TextBlock Text="🚗" FontSize="34"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="AutoWynajem"
                           FontSize="24" FontWeight="Bold" Foreground="#FFFFFFFF"
                           HorizontalAlignment="Center" />
                <TextBlock Text="SYSTEM ZARZĄDZANIA FLOTĄ"
                           FontSize="10" Foreground="#5AFFFFFF"
                           FontWeight="SemiBold" LetterSpacing="1.5"
                           HorizontalAlignment="Center" Margin="0,6,0,0" />
                <Border CornerRadius="8" Background="#14FFFFFF"
                        Padding="16,6" Margin="0,28,0,0"
                        HorizontalAlignment="Center">
                    <TextBlock Text="v1.0.0-beta" FontSize="11" Foreground="#4DFFFFFF" />
                </Border>
            </StackPanel>
        </Border>

        <!-- Right form area -->
        <Border Grid.Column="1" Background="{DynamicResource BgDark}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                        Width="340">

                <TextBlock Text="Zaloguj się"
                           FontSize="26" FontWeight="Bold"
                           Foreground="{DynamicResource Text1}" />
                <TextBlock Text="Wprowadź dane konta, aby uzyskać dostęp do systemu"
                           FontSize="13" Foreground="{DynamicResource Text3}"
                           TextWrapping="Wrap" Margin="0,6,0,28" />

                <!-- Error box -->
                <Border IsVisible="{Binding HasError}"
                        Background="#14EF4444" BorderBrush="#33EF4444"
                        BorderThickness="1" CornerRadius="8"
                        Padding="14,11" Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="⚠" Foreground="{DynamicResource Red}"
                                   VerticalAlignment="Center" FontSize="13" />
                        <TextBlock Text="{Binding ErrorMessage}"
                                   Foreground="{DynamicResource Red}"
                                   FontSize="13" TextWrapping="Wrap"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Username -->
                <TextBlock Text="LOGIN" FontSize="11" FontWeight="Bold"
                           Foreground="{DynamicResource Text3}"
                           Margin="0,0,0,7" />
                <TextBox Text="{Binding Username}"
                         Watermark="Nazwa użytkownika"
                         Background="{DynamicResource BgInput}"
                         Foreground="{DynamicResource Text1}"
                         BorderBrush="{DynamicResource Border}"
                         BorderThickness="1.5" CornerRadius="8"
                         Height="44" Padding="16,0" FontSize="14"
                         Margin="0,0,0,18" />

                <!-- Password -->
                <TextBlock Text="HASŁO" FontSize="11" FontWeight="Bold"
                           Foreground="{DynamicResource Text3}"
                           Margin="0,0,0,7" />
                <TextBox Text="{Binding Password}"
                         Watermark="Wprowadź hasło"
                         PasswordChar="•"
                         Background="{DynamicResource BgInput}"
                         Foreground="{DynamicResource Text1}"
                         BorderBrush="{DynamicResource Border}"
                         BorderThickness="1.5" CornerRadius="8"
                         Height="44" Padding="16,0" FontSize="14"
                         Margin="0,0,0,28" />

                <!-- Login button -->
                <Button Content="Zaloguj się"
                        Command="{Binding LoginCommand}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Background="{DynamicResource Accent}"
                        Foreground="{DynamicResource Text1}"
                        FontSize="14" FontWeight="SemiBold"
                        Height="46" CornerRadius="8" />

                <TextBlock Text="Demo: admin / Admin123!"
                           FontSize="12" Foreground="{DynamicResource Text4}"
                           HorizontalAlignment="Center" Margin="0,16,0,0" />
            </StackPanel>
        </Border>

    </Grid>
</rxui:ReactiveWindow>
